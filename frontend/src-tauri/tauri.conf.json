{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAIMon Desktop",
  "version": "0.1.0",
  "identifier": "com.daimon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DAIMon — Distributed AI Monsters",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7777 http://localhost:7777; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
